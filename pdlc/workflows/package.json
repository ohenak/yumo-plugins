{
  "name": "pdlc-workflows",
  "version": "1.0.0",
  "type": "module",
  "description": "PDLC orchestrate-dev workflow tests",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "c8 npm test"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "jest": "^29.7.0"
  },
  "//c8": "Coverage is measured by c8, not by jest's own --coverage: under --experimental-vm-modules the modules under test are evaluated as ESM through jest's vm-module path, where babel instrumentation reports 0% for them. c8 reads V8's own coverage and sees them. The include set is the modules this feature edits (CODE_REVIEW v1 §1-2); dist/ is generated and __tests__/ is the measuring instrument, so neither is a subject.",
  "c8": {
    "include": [
      "orchestrate-dev.js",
      "orchestrate-queue.js",
      "build-runtime.mjs"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "report-dir": "coverage",
    "check-coverage": true,
    "branches": 85,
    "lines": 90,
    "functions": 90,
    "statements": 90
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "globalSetup": "<rootDir>/__tests__/helpers/skipSinkSetup.js",
    "globalTeardown": "<rootDir>/__tests__/helpers/skipSinkTeardown.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/",
      "/__tests__/fixtures/"
    ]
  }
}
